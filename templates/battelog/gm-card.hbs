<div class="battelog-gm-card">
    <div class="battelog-gm-head">
        <span class="battelog-gm-title">
            <i class="fas fa-flag-checkered"></i> Combat Concluded
        </span>
        <span class="battelog-gm-tag">
            <i class="fas fa-user-shield"></i> GM ONLY
        </span>
    </div>
    <div class="battelog-gm-body">
        <div class="battelog-gm-row">
            <div class="battelog-gm-icon-tile">
                <i class="fas fa-clipboard-check"></i>
            </div>
            <div>
                <div class="battelog-gm-label-strong">COMBAT ENCOUNTER</div>
                <div class="battelog-gm-sub">{{mission.squadStatus}} · {{mission.rounds}} rounds</div>
            </div>
        </div>

        <div>
            <div class="battelog-gm-label">Record Outcome</div>
            <div class="battelog-outcome-toggle" role="group">
                <button type="button" data-action="setOutcome" data-value="VICTORY"
                        class="battelog-outcome-btn win{{#if isVictory}} on{{/if}}">
                    <i class="fas fa-trophy"></i> VICTORY
                </button>
                <button type="button" data-action="setOutcome" data-value="DEFEAT"
                        class="battelog-outcome-btn lose{{#unless isVictory}} on{{/unless}}">
                    <i class="fas fa-skull"></i> DEFEAT
                </button>
            </div>
        </div>

        <div>
            <div class="battelog-gm-label">
                <i class="fas fa-star" style="color: var(--la-amber, #eab308);"></i> Award MVP
            </div>
            <div class="battelog-mvp-grid">
                {{#each players}}
                <button type="button" data-action="setMvp" data-value="{{id}}"
                        class="battelog-mvp-btn{{#if @root.mvpFlags.[@index]}} on{{/if}}"
                        title="{{callsign}}">
                    {{#if @root.mvpFlags.[@index]}}<i class="fas fa-star"></i>{{/if}}
                    {{callsign}}
                </button>
                {{/each}}
            </div>
        </div>

        <div class="battelog-gm-actions">
            <button type="button" data-action="dismiss" class="battelog-btn-secondary">
                Dismiss
            </button>
            <button type="button" data-action="broadcast" class="battelog-btn-primary">
                <i class="fas fa-satellite-dish"></i> Broadcast Recap
            </button>
        </div>

        <p class="battelog-gm-footer-note">
            Visible to all connected pilots.
        </p>
    </div>
</div>
